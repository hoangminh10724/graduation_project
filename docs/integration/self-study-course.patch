+"""Account-owned course attempts. The speech service owns catalog versions and marking."""
+import hashlib
+import os
+from uuid import UUID
+import httpx
+from fastapi import APIRouter, HTTPException
+from pydantic import BaseModel, Field
+from sqlalchemy import ForeignKey, Index, JSON, String, UniqueConstraint, select
+from sqlalchemy.exc import IntegrityError
+from sqlalchemy.orm import Mapped, mapped_column
+from .auth import CurrentUser, DB
+from .models import Base, Card
+
+router = APIRouter(prefix="/course")
+
+class CourseAttempt(Base):
+    __tablename__ = "course_attempts"
+    __table_args__ = (
+        UniqueConstraint("user_id","request_id",name="uq_course_attempt_user_request"),
+        Index("ix_course_attempts_user_id_id","user_id","id"),
+    )
+    id: Mapped[int] = mapped_column(primary_key=True)
+    user_id: Mapped[int] = mapped_column(ForeignKey("users.id"))
+    request_id: Mapped[str] = mapped_column(String(36))
+    fingerprint: Mapped[str] = mapped_column(String(64))
+    result: Mapped[dict] = mapped_column(JSON)
+
+class Attempt(BaseModel):
+    attempt_id: UUID
+    version: str = Field(max_length=80)
+    lesson: str = Field(max_length=80)
+    exercise: str = Field(max_length=24)
+    answer: str = Field(max_length=500)
+
+async def course_service(route, data):
+    url=os.getenv("AI_SERVICE_URL","http://localhost:8001").rstrip("/")+"/demo/course/"+route
+    try:
+        async with httpx.AsyncClient(timeout=20) as client:
+            response=await client.post(url,json=data)
+    except httpx.HTTPError:
+        raise HTTPException(503,"Course marking is unavailable. Retry this attempt.") from None
+    if response.status_code!=200:
+        raise HTTPException(response.status_code if response.status_code in (404,409,422) else 503,"Reopen this exercise or retry.")
+    return response.json()
+
+def replay(row, fingerprint):
+    if row.fingerprint!=fingerprint:
+        raise HTTPException(409,"Attempt ID already belongs to a different answer.")
+    return row.result
+
+@router.post("/attempts")
+async def submit(payload:Attempt,user:CurrentUser,db:DB):
+    uid=user.id
+    key=str(payload.attempt_id)
+    fingerprint=hashlib.sha256(payload.model_dump_json().encode()).hexdigest()
+    query=select(CourseAttempt).where(CourseAttempt.user_id==uid,CourseAttempt.request_id==key)
+    previous=db.scalar(query)
+    if previous:return replay(previous,fingerprint)
+    result=await course_service("grade",payload.model_dump(mode="json"))
+    db.add(CourseAttempt(user_id=uid,request_id=key,fingerprint=fingerprint,result=result))
+    try:
+        db.commit()
+    except IntegrityError:
+        db.rollback()
+        previous=db.scalar(query)
+        if previous:return replay(previous,fingerprint)
+        raise
+    return result
+
+@router.get("/state")
+async def state(user:CurrentUser,db:DB):
+    events=db.scalars(select(CourseAttempt.result).where(CourseAttempt.user_id==user.id).order_by(CourseAttempt.id)).all()
+    return await course_service("study",list(events))
+
+@router.get("/words")
+def words(user:CurrentUser,db:DB):
+    cards=db.scalars(select(Card).where(Card.user_id==user.id,Card.practice_key.is_not(None)).order_by(Card.id.desc()))
+    return [{"word":c.front,"situation":c.situation or ""} for c in cards]
