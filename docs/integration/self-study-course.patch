+from uuid import uuid4
+
+from test_cards import api, register
+from app import course
+
+def test_owned_retries_resume_and_words(api,monkeypatch):
+    client,_=api
+    events=[]
+    async def service(route,data):
+        if route=="study":return {"events":data}
+        events.append(data)
+        return {**{k:data[k] for k in ("version","lesson","exercise","attempt_id")},"skill":"IPA","outcome":"correct","day":"2026-11-24"}
+    monkeypatch.setattr(course,"course_service",service)
+    owner=register(client,"learner@example.com")
+    other=register(client,"second@example.com")
+    body={"attempt_id":str(uuid4()),"version":"test","lesson":"ship-01","exercise":"p4","answer":"sit"}
+    assert client.post("/course/attempts",json=body).status_code==401
+    first=client.post("/course/attempts",headers=owner,json=body)
+    assert first.status_code==200
+    assert client.post("/course/attempts",headers=owner,json=body).json()==first.json()
+    assert client.post("/course/attempts",headers=owner,json={**body,"answer":"x"}).status_code==409
+    assert len(events)==1
+    assert client.get("/course/state",headers=other).json()=={"events":[]}
+    login=client.post("/auth/login",json={"email":"learner@example.com","password":"test-pass"}).json()
+    again={"Authorization":"Bearer "+login["access_token"]}
+    assert client.get("/course/state",headers=again).json()["events"]==[first.json()]
+    assert client.put("/practice-words",headers=again,json={"word":"rain check","situation":"decline an invitation"}).status_code==200
+    assert client.get("/course/words",headers=again).json()[0]["word"]=="rain check"
+    assert client.get("/course/words",headers=other).json()==[]

