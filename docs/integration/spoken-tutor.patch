+"""Send a spoken turn and server-derived acoustic evidence through the tutor."""
+import os
+import httpx
+from fastapi import APIRouter, HTTPException, Query, Request
+
+from .auth import CurrentUser, DB
+from .dialogue import chat_events, reserve_turn, release_turn
+from .audio import MAX_AUDIO_BYTES
+
+router=APIRouter()
+
+
+@router.post("/sessions/{session_id}/spoken-turn")
+async def spoken_turn(session_id:int,request:Request,user:CurrentUser,db:DB,focus:str=Query("",max_length=120)):
+    if request.headers.get("content-type","").split(";")[0]!="audio/wav":
+        raise HTTPException(415,"Send a WAV recording.")
+    messages,lease=reserve_turn(db,user.id,session_id)
+    try:
+        payload=bytearray()
+        async for chunk in request.stream():
+            if len(payload)+len(chunk)>MAX_AUDIO_BYTES:raise HTTPException(413,"Recording too large.")
+            payload.extend(chunk)
+        url=os.getenv("AI_SERVICE_URL","http://localhost:8001").rstrip("/")+"/tutor/observe"
+        async with httpx.AsyncClient(timeout=httpx.Timeout(180,connect=5)) as client:
+            try:
+                response=await client.post(url,files={"audio":("turn.wav",bytes(payload),"audio/wav")},data={"focus":focus})
+                if response.status_code in (400,413,415,422):raise HTTPException(response.status_code,"Try a clearer, shorter recording.")
+                response.raise_for_status()
+                result=response.json()
+                text=result["text"]
+                evidence=result["observation"]
+                hint=evidence["message"]
+                if not evidence.get("word") and evidence.get("phrasing"):
+                    hint+=" Separate phrasing observation: "+evidence["phrasing"]["message"]
+            except (httpx.HTTPError,ValueError,KeyError,TypeError) as exc:
+                raise HTTPException(503,"Speech analysis unavailable.") from exc
+        reply=None
+        async for event in chat_events(db,session_id,text,messages,pronunciation_hint=
+            "Recording-based, estimated word boundaries. Give at most one conditional practice cue. "+hint):
+            if event["type"]=="done":reply=event["text"]
+        return {"text":text,"observation":evidence,"reply":reply}
+    finally:
+        release_turn(db,session_id,lease)
