+def save_practice_word(payload: PracticeWord, user: CurrentUser, db: DB) -> CardView:
+    word = unicodedata.normalize("NFC", " ".join(payload.word.split()))
+    key = word.replace("’", "'").casefold()
+    user_id = user.id
+    query = select(Card).where(Card.user_id == user_id, Card.practice_key == key).with_for_update()
+    card = db.scalar(query)
