+def test_practice_word_saves_preserve_schedule_and_owner(api):
+    client, _ = api
+    owner = register(client, "practice@example.test")
+    other = register(client, "second@example.test")
+    original = {"word": "Rain  check", "phrase": "Could I take a rain check?", "situation": "Can you join us?"}
+    card = client.put("/practice-words", headers=owner, json=original).raise_for_status().json()
+    assert card["practice_key"] == "rain check" and card["situation"] == original["situation"]
+    review = {"card_id": card["id"], "rating": 3, "request_id": str(uuid4())}
+    scheduled = client.post("/reviews", headers=owner, json=review).raise_for_status().json()["card"]
+    edit = {**original, "word": "RAIN CHECK", "situation": "How about lunch?"}
+    updated = client.put("/practice-words", headers=owner, json=edit).raise_for_status().json()
+    assert updated["id"] == card["id"] and updated["situation"] == edit["situation"]
+    for field in ("due", "stability", "difficulty"):
+        assert scheduled[field] == updated[field]
+    assert client.put("/practice-words", headers=owner, json=edit).json() == updated
+    assert client.get("/cards/due", headers=owner).json() == []
+    independent = client.put("/practice-words", headers=other, json=original).raise_for_status().json()
+    assert independent["id"] != card["id"]
+    assert client.get("/cards/due", headers=other).json() == [independent]
