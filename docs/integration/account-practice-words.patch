+"""Keep source expressions and reply situations on learner-owned review cards."""
+import sqlalchemy as sa
+from alembic import op
+
+revision = "0004_practice_words"
+down_revision = "0003_review_retries"
+branch_labels = None
+depends_on = None
+
+
+def upgrade() -> None:
+    op.add_column("cards", sa.Column("practice_key", sa.String(300), nullable=True))
+    op.add_column("cards", sa.Column("situation", sa.Text(), nullable=True))
+    op.create_index("uq_cards_user_practice_key", "cards", ["user_id", "practice_key"], unique=True)
+
+
+def downgrade() -> None:
+    op.drop_index("uq_cards_user_practice_key", table_name="cards")
+    with op.batch_alter_table("cards") as batch:
+        batch.drop_column("situation")
+        batch.drop_column("practice_key")
