+def test_existing_cards_survive_practice_word_migration(monkeypatch):
+    from sqlalchemy import text
+
+    monkeypatch.setenv("DATABASE_URL", "sqlite://")
+    config = Config(Path(__file__).resolve().parents[1] / "alembic.ini")
+    engine = get_engine()
+    try:
+        command.upgrade(config, "0003_review_retries")
+        with engine.begin() as conn:
+            conn.execute(text("INSERT INTO users (id,email,password_hash) VALUES (1,'test@example.test','fixture')"))
+            for card_id in (1, 2):
+                conn.execute(text("INSERT INTO cards (id,user_id,front,back,stability,difficulty) "
+                                  "VALUES (:id,1,'seat','chỗ ngồi',4.3,2.1)"), {"id":card_id})
+        command.upgrade(config, "head")
+        with engine.connect() as conn:
+            rows = conn.execute(text("SELECT front,stability,practice_key,situation FROM cards ORDER BY id")).all()
+            assert rows == [("seat",4.3,None,None)] * 2
+        command.downgrade(config, "0003_review_retries")
+        with engine.connect() as conn:
+            assert conn.execute(text("SELECT count(*) FROM cards")).scalar_one() == 2
+    finally:
+        engine.dispose()
+        get_engine.cache_clear()
