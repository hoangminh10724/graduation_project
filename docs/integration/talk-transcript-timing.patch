+++ b/backend/tests/test_transcript_timing.py
@@ -0,0 +1,17 @@
+import pytest
+
+from app.speech import Transcript
+
+
+def test_transcript_preserves_word_times():
+    words = [{"word": "sit", "start": 0.1, "end": 0.3}]
+    result = Transcript.model_validate({"text": "sit", "words": words}).model_dump(exclude_none=True)
+    assert result == {"text": "sit", "words": words}
+
+
+@pytest.mark.parametrize("words", [None, [], "partial", [{"word": "", "start": 0, "end": 1}],
+    [{"word": "sit", "start": 2, "end": 1}], [{"word": "sit", "start": 0, "end": float("nan")}],
+    [{"word": "sit", "start": 0, "end": 1}, {"word": "here", "start": 0.5, "end": 2}]])
+def test_bad_optional_times_preserve_the_text(words):
+    result = Transcript.model_validate({"text": "sit here", "words": words}).model_dump(exclude_none=True)
+    assert result == {"text": "sit here"}
